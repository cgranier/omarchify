#!/usr/bin/env bash
# Pick a file with Walker, newest first.
#   omarchify-menu-file <label> <colon:separated:paths> <"ext ext ext"> [walker args...]
# Adapted from omakub-menu-file (drops the omakub-launch-walker wrapper).
PATH="$(cd "$(dirname "$(readlink -f "$0")")" && pwd):$HOME/.local/bin:$PATH"
set -euo pipefail

(( $# >= 3 )) || { echo "usage: omarchify-menu-file <label> <paths> <formats> [walker args...]" >&2; exit 1; }
label="$1"; paths_arg="$2"; formats_arg="$3"; shift 3

IFS=: read -r -a paths <<<"$paths_arg"
read -r -a formats <<<"$formats_arg"
(( ${#paths[@]} && ${#formats[@]} )) || { echo "need at least one path and one format" >&2; exit 1; }

existing=()
for p in "${paths[@]}"; do [[ -e $p ]] && existing+=("$p"); done
(( ${#existing[@]} )) || { echo "none of these paths exist: $paths_arg" >&2; exit 1; }

find_args=("${existing[@]}" "(" -type d -name ".*" ! -name "." -prune ")" -o -type f ! -name ".*" "(")
first=true
for f in "${formats[@]}"; do
  [[ $first == true ]] && first=false || find_args+=(-o)
  find_args+=(-iname "*.${f#.}")
done
find_args+=(")" -printf '%T@\t%p\n')

# An empty picker is indistinguishable from a broken one, so say so instead.
mapfile -t found < <(find "${find_args[@]}" 2>/dev/null | sort -rn | cut -f2-)
if (( ${#found[@]} == 0 )); then
  echo "No matching files under: ${paths_arg//:/, }" >&2
  exit 1
fi

printf '%s\n' "${found[@]}" \
  | omarchify-launch-walker --dmenu --width 800 --minheight 1 --maxheight 500 -p "$label…" "$@" 2>/dev/null
