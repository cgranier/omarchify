#!/bin/bash
# Rebuild ~/.XCompose from the repo sources as a SELF-CONTAINED file.
# Only "include %L" (the locale table) is kept: nested includes proved to be an
# unnecessary variable when debugging why sequences would not resolve.
# ibus caches the compose table at startup, so it is restarted at the end.
set -euo pipefail
HERE=$(cd "$(dirname "$(readlink -f "$0")")/../config/xcompose" && pwd)
{
  echo "# Generated by omarchify-xcompose-build. Do not edit; edit the sources."
  echo "# Sources: $HERE/{compose,personal}"
  echo
  echo 'include "%L"'
  echo
  grep -v -E '^\s*include ' "$HERE/compose"
  echo
  cat "$HERE/personal"
} > ~/.XCompose
command -v ibus >/dev/null 2>&1 && ibus restart >/dev/null 2>&1 || true
echo "~/.XCompose rebuilt ($(grep -c '^<Multi_key>' ~/.XCompose) sequences); ibus restarted."
